
class Solution {
    public int lengthOfLastWord(String s) {
       int i = s.length() - 1;

        while (i >= 0 && s.charAt(i) == ' ') {
            i--;
        }

        int a = i;
        while (a >= 0 && s.charAt(a) != ' ') {
            a--;
        }

        return i - a;        
    }
}
